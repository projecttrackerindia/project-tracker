# Copy to .env (never commit .env). Used by docker-compose.yml.
POSTGRES_PASSWORD=change-me
# At least 32 characters, random. Example generator:  openssl rand -base64 48
JWT_SIGNING_KEY=

# Optional, for local trials only: create a platform admin and the demo organization on first start.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=Admin@12345
# SEED_DEMO=true            # demo@example.com / Demo@12345 (+ 5 teammates, sample projects)
# For a clean, production-like start keep SEED_DEMO=false and bootstrap real platform admins once, without storing their
# passwords in .env, e.g.:
#   docker compose run -d --no-deps --name pm-bootstrap -e Seed__Admins__0__Email=you@example.com -e Seed__Admins__0__Password=... -e Seed__Admins__0__Name=You api
# then remove that container (docker rm -f pm-bootstrap) and start the stack normally.

# Billing currency plans start out in (INR by default). After the first start it is changed in the admin portal, not here.
#   BILLING_CURRENCY=INR

# Open the app to other devices on your network (default: this computer only).
#   WEB_BIND=0.0.0.0
#   APP_URL=http://<this-computer-ip>:8080

# Real email (notifications, invitations, verification). Default: messages are only written to the API log.
#   EMAIL_PROVIDER=Smtp
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_SSL=true
#   SMTP_USER=
#   SMTP_PASSWORD=
#   SMTP_FROM=no-reply@your-domain.com

# Key that encrypts authenticator-app secrets (two-step verification). Generate a long random value and keep it stable.
MFA_ENCRYPTION_KEY=

# Shared cache + rate limits across several API servers (optional; without it each server keeps its own in memory).
#   REDIS_URL=redis:6379      # with: docker compose --profile redis up -d

# Traces and metrics (OpenTelemetry). Leave empty to send nothing. See README, "Observability".
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318      # with: docker compose --profile observability up -d
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com:4318   # or your own collector / vendor
