# Project Tracker — environment variables
#
# Copy this file to .env for local development (or set these directly in
# Railway → Variables for a deployment). Every value below is a placeholder —
# never commit real secrets. This file previously didn't exist at all
# (architecture review, gap noted alongside OPS items); the full list of
# variable names below was recovered by reading every os.environ.get(...)
# call across app.py, ai_provider.py, and scaling_runtime.py.

# ── Core ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
SECRET_KEY=                       # 32+ random chars — sessions won't survive restarts without it
HTTPS=                            # set to 1 behind a TLS-terminating proxy that isn't Railway/Render
APP_BASE_URL=https://your-domain.example
ALLOWED_ORIGINS=                  # comma-separated; defaults to APP_BASE_URL
PORT=8080

# ── Admin / platform ─────────────────────────────────────────────────────
ADMIN_TOKEN_SECRET=                # 32+ random chars — signs the platform-admin bearer token; keep separate from SECRET_KEY
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=

# ── Vault / secrets encryption ───────────────────────────────────────────
VAULT_ENCRYPTION_KEY=              # Fernet key; falls back to a persisted local file if unset (see app.py)
VAULT_MASTER_UNLOCK_MINUTES=15

# ── AI (Anthropic) ───────────────────────────────────────────────────────
PLATFORM_AI_API_KEY=sk-ant-xxxxxxxxxxxxxxxx   # shared/platform fallback key; workspaces may supply their own instead
AI_CHAT_MAX_TASKS_IN_CONTEXT=
AI_CHAT_MAX_PROJECTS_IN_CONTEXT=

# ── Email ─────────────────────────────────────────────────────────────────
EMAIL_ENABLED=1
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Web Push ──────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── OAuth / integrations ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Billing (Stripe) — leave unset while billing isn't live ─────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=             # without this, the webhook endpoint returns 503 rather than trusting unverified events
STRIPE_PRICE_TEAM=
STRIPE_PRICE_ENTERPRISE=

# ── Error aggregation (Sentry) — optional, no-op if unset ───────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=                # defaults to RAILWAY_ENVIRONMENT, then "production"
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Scaling / infra — optional, degrade gracefully if unset ─────────────
REDIS_URL=
RQ_DEFAULT_QUEUE=default
ASYNC_BACKEND=
PG_POOL_SIZE=40
WEB_CONCURRENCY=2
WEB_TIMEOUT=75
WEB_KEEPALIVE=5
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100
RUN_STARTUP_MIGRATIONS=1           # on by default (see start.sh) — set to 0 to opt a specific deploy out

# ── Backups (scripts/backup_db.sh — see docs/BACKUP_RESTORE.md) ─────────
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
S3_BUCKET=                         # also used by scaling_runtime.py for uploaded-file storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Rate limiting ─────────────────────────────────────────────────────────
RL_DM_SEND_PER_MIN=
RL_POLL_PER_MIN=
RL_PRESENCE_PER_MIN=

# ── Uploads ───────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=
WORKSPACE_UPLOAD_QUOTA_BYTES=
