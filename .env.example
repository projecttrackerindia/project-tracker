# Copy to .env (never commit .env). Used by docker-compose.yml.
POSTGRES_PASSWORD=change-me
# At least 32 characters, random. Example generator:  openssl rand -base64 48
JWT_SIGNING_KEY=

# Optional, for local trials only: create a platform admin and the demo organization on first start.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=Admin@12345
# SEED_DEMO=true            # demo@example.com / Demo@12345 (+ 5 teammates, sample projects)
# For a clean, production-like start keep SEED_DEMO=false and bootstrap real platform admins once, without storing their
# passwords in .env, e.g.:
#   docker compose run -d --no-deps --name pm-bootstrap -e Seed__Admins__0__Email=you@example.com -e Seed__Admins__0__Password=... -e Seed__Admins__0__Name=You api
# then remove that container (docker rm -f pm-bootstrap) and start the stack normally.

# Billing currency plans start out in (INR by default). After the first start it is changed in the admin portal, not here.
#   BILLING_CURRENCY=INR

# Open the app to other devices on your network (default: this computer only).
#   WEB_BIND=0.0.0.0
#   APP_URL=http://<this-computer-ip>:8080

# Real email (notifications, invitations, verification). Default: messages are only written to the API log.
# Option A - SMTP. Some hosts (Railway among them) block outbound SMTP on cheaper plans; if sending times out, use Resend below instead.
#   EMAIL_PROVIDER=Smtp
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_SSL=true
#   SMTP_USER=
#   SMTP_PASSWORD=
#   SMTP_FROM=no-reply@your-domain.com
# Option B - Resend (resend.com), sent over HTTPS so it works even where SMTP is blocked. RESEND_FROM's domain must be
# verified in the Resend dashboard first, or delivery fails.
#   EMAIL_PROVIDER=Resend
#   RESEND_API_KEY=
#   RESEND_FROM=Project Tracker <no-reply@your-domain.com>

# Key that encrypts authenticator-app secrets (two-step verification). Generate a long random value and keep it stable.
MFA_ENCRYPTION_KEY=

# Shared cache + rate limits across several API servers (optional; without it each server keeps its own in memory).
#   REDIS_URL=redis:6379      # with: docker compose --profile redis up -d

# Traces and metrics (OpenTelemetry). Leave empty to send nothing. See README, "Observability".
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318      # with: docker compose --profile observability up -d
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com:4318   # or your own collector / vendor

# ---------------------------------------------------------------------------------------------------------------------
# Payments. Leave BILLING_PROVIDER=Mock while testing: choosing a paid plan then succeeds without taking any money.
# For real subscriptions use Razorpay (razorpay.com): create the keys under Settings -> API keys, and a webhook under
# Settings -> Webhooks pointing to  https://<your site>/api/v1/billing/webhooks/razorpay  with a secret of your choice and the
# events subscription.activated, subscription.charged, subscription.pending, subscription.halted, subscription.cancelled,
# subscription.completed. Start with the rzp_test_ keys; switch to rzp_live_ when you are ready. Admin -> System health ->
# Go-live checklist shows which of these is still missing.
# BILLING_PROVIDER=Razorpay
# BILLING_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# BILLING_RAZORPAY_KEY_SECRET=
# BILLING_RAZORPAY_WEBHOOK_SECRET=
#
# E-mail extras: the sender name people see, where replies go, and (Resend only) the secret that signs delivery events so
# bounced addresses are blocked automatically: Resend dashboard -> Webhooks -> https://<your site>/api/v1/email/webhooks/resend
# EMAIL_FROM_NAME=Project Tracker
# EMAIL_REPLY_TO=support@your-domain.com
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx


# Push to the Android app (Firebase Cloud Messaging): the service-account key JSON on ONE line. See deploy/DEPLOY.md, "Android alerts".
PUSH_FCM_SERVICE_ACCOUNT_JSON=
