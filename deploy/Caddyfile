# Public entry point: Caddy gets and renews HTTPS certificates by itself (Let's Encrypt) and forwards to the web container.
# DOMAIN and ACME_EMAIL come from .env (see deploy/.env.production.example). The domain's DNS must point at this server,
# and ports 80 and 443 must be reachable from the internet.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# TLS 1.2 is the floor (ASVS 9.1.3); Caddy's defaults already pick modern AEAD cipher suites and enable OCSP stapling.
	tls {
		protocols tls1.2 tls1.3
	}

	# Browsers are told to always use HTTPS for this site and its subdomains, for two years (preload-eligible). The app's own
	# headers (CSP, frame and content-type rules) come from the web container; these are the ones that must hold even on an error page.
	header {
		# Applied after the upstream answers, so these replace (never duplicate) the same headers from nginx.
		defer
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		-Server
		-X-Powered-By
	}

	# Large uploads are allowed through; the API enforces the real per-plan limit.
	request_body {
		max_size 520MB
	}

	reverse_proxy web:80 {
		# Send each piece of a streamed response (the AI assistant's live answers) as soon as it arrives instead of collecting it first.
		flush_interval -1
		# Tell the app the visitor used https, so cookies are marked Secure and links use https.
		header_up X-Forwarded-Proto {scheme}
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}
