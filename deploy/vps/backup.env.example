# Copy to backup.env on the server, fill in, then: chmod 600 backup.env
# backup.env holds credentials and is never committed.

# Where backups go. Use a DIFFERENT company from the one hosting the server: if the host has a bad
# day, the backups must not be having it too. Cloudflare R2 and Backblaze B2 both work.
S3_BUCKET=projecttracker-backups
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Credentials for that bucket, for the aws CLI. Give this key write access to this bucket and nothing else.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# The passphrase that encrypts every backup. Keep a copy in your password manager.
# Lose this file and the password manager entry and the backups cannot be read by anyone, including you.
PASSPHRASE_FILE=/root/.pt-backup-passphrase

# Must match the .env used by docker-compose.yml
DB_NAME=projecttracker
DB_USER=pt
COMPOSE_DIR=/opt/pt

# Retention
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=3

# Where failures are reported. Without this, a backup that stops working tells nobody.
ALERT_WEBHOOK=
NOTIFY_ON_SUCCESS=0
