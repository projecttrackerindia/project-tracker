# Production settings. Copy to ../.env on the server and fill in every value. NEVER commit the real file.

# ---- public address (DNS must point at this server; ports 80 and 443 open)
DOMAIN=projects.example.com
ACME_EMAIL=admin@example.com
APP_URL=https://projects.example.com

# ---- secrets: generate each one, keep them stable, and store them in your password manager
#   openssl rand -base64 36        (database password)
#   openssl rand -base64 48        (the two keys)
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=
MFA_ENCRYPTION_KEY=

# ---- first administrator: set BOTH once, sign in, change the password at once, then remove these two lines
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---- demo organization (sample projects/tasks with a well-known password): off by default here (only turned on in local dev).
# Leave unset. If you ever set it to true to look around, set it back to false and delete the demo org - the go-live checklist
# (Admin > System health) fails loudly while it still exists.
# SEED_DEMO=false

# ---- e-mail (verification, invitations, password reset, notifications). Then use Admin > System health > "Send test email".
EMAIL_PROVIDER=Smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@projects.example.com

# ---- backups (the bundled service dumps the database and the uploaded files every night)
BACKUP_HOUR_UTC=02
BACKUP_KEEP_DAYS=14

# ---- search engines (optional; see deploy/SEO.md). Paste the tokens the webmaster tools give you, then rebuild the web image.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=
